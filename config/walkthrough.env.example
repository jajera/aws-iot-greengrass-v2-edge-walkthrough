# Copy to walkthrough.env and edit. Never commit walkthrough.env.
#   cp config/walkthrough.env.example config/walkthrough.env

# AWS
AWS_REGION=ap-southeast-2
AWS_PROFILE=lab

# Naming (keep short; used in Thing names and resource tags)
PROJECT_NAME=gg-edge-wt
ENVIRONMENT=dev

# Greengrass core device (NUC or other Linux host)
CORE_THING_NAME=${PROJECT_NAME}-${ENVIRONMENT}-core
CORE_THING_GROUP=${PROJECT_NAME}-${ENVIRONMENT}-cores

# Client devices (ESP32-S3 zones) — IoT Thing + cert; LAN MQTT to Moquette
CLIENT_THING_NAME=${PROJECT_NAME}-${ENVIRONMENT}-esp32-1
# Auth selectionRule prefix (thingName: ${CLIENT_THING_PREFIX}*) — matches -1, -2, -3
CLIENT_THING_PREFIX=${PROJECT_NAME}-${ENVIRONMENT}-esp32

# Optional second / third ESP32-S3 (same Auth group via CLIENT_THING_PREFIX*)
# Leave unset if you only have one board.
# CLIENT_THING_NAME_2=${PROJECT_NAME}-${ENVIRONMENT}-esp32-2
# CLIENT_CERTS_DIR_2=certs/client-2
# CLIENT_THING_NAME_3=${PROJECT_NAME}-${ENVIRONMENT}-esp32-3
# CLIENT_CERTS_DIR_3=certs/client-3

# Local paths (relative to repo root unless absolute)
CERTS_DIR=certs
CORE_CERTS_DIR=certs/core
CLIENT_CERTS_DIR=certs/client

# Greengrass nucleus install root on the core host
GG_ROOT=/greengrass/v2

# NUC / core host (fill after Ubuntu is up — see Install Nucleus)
NUC_USER=ubuntu
NUC_HOST=192.168.1.50

# Role alias name used at Nucleus install (created in cloud step)
ROLE_ALIAS_NAME=${PROJECT_NAME}-${ENVIRONMENT}-token-alias

# Cloud integration (Ship the edge stack → Edge ML). Bucket names add
# -${AWS_ACCOUNT_ID} on each page, so they are not set here.
ZONE_TABLE=${PROJECT_NAME}-${ENVIRONMENT}-zone-state
ALARM_TOPIC=${PROJECT_NAME}-${ENVIRONMENT}-zone-alarms
COMMAND_FUNCTION=${PROJECT_NAME}-${ENVIRONMENT}-alarm-to-command
# Email that receives the CloudWatch alarm (confirm the SNS subscription mail)
ALERT_EMAIL=you@example.com

# IoT endpoints (fill after cloud lookup — never commit real values in docs)
# AWS_IOT_ENDPOINT=example123abc-ats.iot.ap-southeast-2.amazonaws.com
# AWS_IOT_CRED_ENDPOINT=example123abc.credentials.iot.ap-southeast-2.amazonaws.com
