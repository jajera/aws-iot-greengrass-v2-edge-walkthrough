---
/**
 * ZoneStateDiagram — this page: same telemetry/actuator topics, DynamoDB keeps
 * the latest item per zone + kind (overwrite via PutItem).
 * Icons from https://aws-icons.johna.kiwi/ under AWS Trademark Guidelines.
 */
const ICONS = "https://aws-icons.johna.kiwi/icons";

const img = {
  client: `${ICONS}/resource/iot/Res_AWS-IoT_Thing_FreeRTOS-Device_48.svg`,
  iot: `${ICONS}/service/iot/Arch_AWS-IoT-Core_64.svg`,
  ddb: `${ICONS}/service/database/Arch_Amazon-DynamoDB_64.svg`,
};
---

<figure class="zs not-content" aria-labelledby="zs-caption">
  <div class="zs-row">
    <div class="zs-node">
      <img src={img.client} alt="" width="40" height="40" loading="lazy" />
      <span class="zs-name">Zones + GgEdgeLoop</span>
      <span class="zs-sub">telemetry/+ · actuator/+</span>
    </div>

    <span class="zs-hop" data-label="bridge → IoT Core">→</span>

    <div class="zs-node zs-node--hub">
      <img src={img.iot} alt="" width="40" height="40" loading="lazy" />
      <span class="zs-name">IoT rules</span>
      <span class="zs-sub">…_telemetry_ddb · …_actuator_ddb</span>
    </div>

    <span class="zs-hop" data-label="PutItem">→</span>

    <div class="zs-node zs-node--dest">
      <img src={img.ddb} alt="" width="40" height="40" loading="lazy" />
      <span class="zs-name">DynamoDB</span>
      <span class="zs-sub">PK thing · SK kind</span>
    </div>
  </div>

  <figcaption id="zs-caption">
    S3 keeps history. This table answers “what is each zone doing right now” —
    latest <code>telemetry</code> and who last drove <code>actuator</code>.
  </figcaption>
</figure>

<style>
  .zs {
    margin: 1.5rem 0;
  }

  .zs-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 1.1rem 0.95rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.9rem;
    background:
      radial-gradient(
        ellipse 90% 55% at 50% -8%,
        var(--patina-accent-soft, color-mix(in oklab, var(--sl-color-accent) 12%, transparent)),
        transparent 70%
      ),
      var(--sl-color-bg-nav);
  }

  .zs-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    width: min(100%, 22rem);
    padding: 0.7rem 0.55rem;
    text-align: center;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.65rem;
    background: var(--sl-color-bg);
  }

  .zs-node--hub {
    border-color: color-mix(in oklab, var(--sl-color-accent) 45%, var(--sl-color-hairline));
  }

  .zs-node--dest {
    border-color: color-mix(in oklab, var(--sl-color-accent) 35%, var(--sl-color-hairline));
  }

  .zs-name {
    font-family: var(--sl-font-headings);
    font-weight: 700;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
  }

  .zs-sub {
    font-size: 0.65rem;
    color: var(--sl-color-gray-3);
    line-height: 1.25;
  }

  /* "label ↓" between vertically stacked nodes. The element's own text is the
     inline "→" glyph — hide it and draw the label + down arrow via pseudos. */
  .zs-hop {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0;
    color: var(--sl-color-accent);
    font-weight: 700;
    line-height: 1;
    font-size: 0;
  }

  .zs-hop::before {
    content: attr(data-label);
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
    line-height: 1.2;
  }

  .zs-hop::after {
    content: "↓";
    font-size: 1.1rem;
    color: var(--sl-color-accent);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.45;
  }

  figcaption code {
    font-size: 0.85em;
    background: var(--sl-color-bg-inline-code);
    padding: 0.05rem 0.3rem;
    border-radius: 0.25rem;
  }
</style>
