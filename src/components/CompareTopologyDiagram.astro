---
/**
 * CompareTopologyDiagram — two side-by-side topologies: ESP32 devices going
 * direct to IoT Core vs through a local Greengrass core hub (this lab).
 *
 * Official AWS Architecture Icons from https://aws-icons.johna.kiwi/, used under
 * the AWS Trademark Guidelines: https://aws.amazon.com/trademark-guidelines/
 */
const ICONS = "https://aws-icons.johna.kiwi/icons";

const img = {
  device: `${ICONS}/resource/iot/Res_AWS-IoT_Thing_FreeRTOS-Device_48.svg`,
  core: `${ICONS}/service/iot/Arch_AWS-IoT-Greengrass_64.svg`,
  iotCore: `${ICONS}/service/iot/Arch_AWS-IoT-Core_64.svg`,
};
---

<figure class="ct not-content" aria-labelledby="ct-caption">
  <div class="ct-grid">
    {/* ---- Direct to IoT Core ---- */}
    <section class="ct-panel">
      <h3 class="ct-panel-head">Direct IoT Core</h3>
      <div class="ct-topo">
        <div class="ct-devices">
          <div class="ct-device">
            <img src={img.device} alt="" width="34" height="34" loading="lazy" />
            <span>ESP32</span>
          </div>
          <div class="ct-device">
            <img src={img.device} alt="" width="34" height="34" loading="lazy" />
            <span>ESP32</span>
          </div>
        </div>

        <span class="ct-link" data-label="TLS MQTT">→</span>

        <div class="ct-node ct-node--cloud">
          <img src={img.iotCore} alt="" width="40" height="40" loading="lazy" />
          <span class="ct-name">IoT Core</span>
        </div>
      </div>
      <p class="ct-note">Each board talks to the cloud; decisions run in the cloud or on every MCU.</p>
    </section>

    {/* ---- Greengrass hub (this lab) ---- */}
    <section class="ct-panel ct-panel--pick">
      <h3 class="ct-panel-head">
        Greengrass hub
        <span class="ct-tag">this lab</span>
      </h3>
      <div class="ct-topo">
        <div class="ct-devices">
          <div class="ct-device">
            <img src={img.device} alt="" width="34" height="34" loading="lazy" />
            <span>ESP32</span>
          </div>
          <div class="ct-device">
            <img src={img.device} alt="" width="34" height="34" loading="lazy" />
            <span>ESP32</span>
          </div>
        </div>

        <span class="ct-link" data-label="LAN mTLS">→</span>

        <div class="ct-node ct-node--core">
          <img src={img.core} alt="" width="40" height="40" loading="lazy" />
          <span class="ct-name">NUC core</span>
        </div>

        <span class="ct-link ct-link--opt" data-label="optional bridge">⇢</span>

        <div class="ct-node ct-node--cloud">
          <img src={img.iotCore} alt="" width="36" height="36" loading="lazy" />
          <span class="ct-name">IoT Core</span>
        </div>
      </div>
      <p class="ct-note">Boards decide on the LAN via the core; cloud mirror is optional.</p>
    </section>
  </div>

  <figcaption id="ct-caption">
    <ul>
      <li><strong>Direct</strong>: fewer moving parts; no local decisions if the cloud is unreachable.</li>
      <li><strong>Hub</strong>: closed loop on the LAN, shared components — but the core is a single point of failure.</li>
    </ul>
  </figcaption>
</figure>

<style>
  .ct {
    margin: 1.5rem 0;
  }

  .ct-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.7rem;
  }

  .ct-panel {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.8rem;
    padding: 0.9rem 0.85rem 1rem;
    background: var(--sl-color-bg-nav);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ct-panel--pick {
    border: 1px solid var(--sl-color-accent);
    background:
      radial-gradient(
        ellipse 90% 60% at 50% -10%,
        var(--patina-accent-soft),
        transparent 70%
      ),
      var(--sl-color-bg-nav);
  }

  .ct-panel-head {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--sl-font-headings);
    font-size: var(--sl-text-base);
    font-weight: 700;
    color: var(--sl-color-white);
    letter-spacing: -0.01em;
  }

  .ct-tag {
    font-family: var(--sl-font);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--sl-color-text-invert);
    background: var(--sl-color-accent);
    padding: 0.1rem 0.4rem;
    border-radius: 0.3rem;
  }

  /* ---- Topology row ---- */
  .ct-topo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    padding: 0.6rem 0;
  }

  .ct-devices {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .ct-device {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-white);
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
  }

  .ct-device img {
    display: block;
  }

  .ct-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    text-align: center;
    padding: 0.65rem 0.6rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    background: var(--sl-color-bg);
  }

  .ct-node--core {
    border-color: color-mix(in oklab, var(--sl-color-accent) 45%, transparent);
  }

  .ct-node--cloud {
    border-color: color-mix(in oklab, var(--sl-color-accent) 28%, transparent);
  }

  .ct-name {
    font-family: var(--sl-font-headings);
    font-weight: 700;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-white);
    letter-spacing: -0.01em;
  }

  /* ---- Connectors: label stacked above the arrow (in flow) ---- */
  .ct-link {
    flex: 0 0 auto;
    align-self: center;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0 0.1rem;
    color: var(--sl-color-accent);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1;
  }

  .ct-link::before {
    content: attr(data-label);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--sl-color-text-accent);
    white-space: nowrap;
  }

  .ct-link--opt {
    color: var(--sl-color-gray-4);
  }

  .ct-link--opt::before {
    color: var(--sl-color-gray-3);
  }

  .ct-note {
    margin: 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    line-height: 1.4;
  }

  /* ---- Narrow: stack topology, arrows read down ---- */
  @media (max-width: 30rem) {
    .ct-topo {
      flex-direction: column;
    }

    .ct-devices {
      flex-direction: row;
    }

    .ct-link {
      flex-direction: row;
      justify-content: center;
      gap: 0.35rem;
      padding: 0.25rem 0;
      font-size: 0;
    }

    .ct-link::before {
      font-size: 0.62rem;
    }

    .ct-link::after {
      content: "↓";
      font-size: 1.05rem;
      line-height: 1;
      color: inherit;
    }
  }

  figcaption {
    margin-top: 0.9rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  figcaption ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  figcaption li {
    position: relative;
    padding-left: 1.1rem;
    line-height: 1.4;
  }

  figcaption li::before {
    content: "›";
    position: absolute;
    left: 0.2rem;
    color: var(--sl-color-accent);
    font-weight: 700;
  }

  figcaption strong {
    color: var(--sl-color-white);
  }
</style>
