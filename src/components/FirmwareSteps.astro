---
/**
 * FirmwareSteps — the three steps on this page, in order (all on the
 * workstation with ESP-IDF). Overview rail above the step-by-step sections
 * (matches the cloud / prepare-nuc / nucleus / deploy / component rails).
 *
 * Official AWS Architecture Icons from https://aws-icons.johna.kiwi/ (general
 * set has Light/Dark variants, swapped per theme in the script below), under
 * the AWS Trademark Guidelines: https://aws.amazon.com/trademark-guidelines/
 */
const ICONS = "https://aws-icons.johna.kiwi/icons";

const gen = (name: string) => ({
  dark: `${ICONS}/resource/general/Res_${name}_48_Dark.svg`,
  light: `${ICONS}/resource/general/Res_${name}_48_Light.svg`,
});

interface Step {
  n: number;
  icon?: string;
  gen?: { dark: string; light: string };
  title: string;
  cli: string;
}

const steps: Step[] = [
  { n: 1, icon: `${ICONS}/resource/iot/Res_AWS-IoT_Certificate_48.svg`, title: "Copy client certs", cli: "cp → main/certs/" },
  { n: 2, gen: gen("Gear"), title: "Configure + flash", cli: "set-target · menuconfig · flash" },
  { n: 3, gen: gen("Magnifying-Glass"), title: "Watch serial log", cli: "wifi · discover · mqtt" },
];
---

<figure class="fs not-content" aria-labelledby="fs-caption">
  <ol class="fs-rail">
    {
      steps.map((s) => (
        <li class="fs-step">
          <span class="fs-num">{s.n}</span>
          {s.gen ? (
            <img class="fs-ico" src={s.gen.dark} data-light={s.gen.light} alt="" width="30" height="30" loading="lazy" />
          ) : (
            <img class="fs-ico" src={s.icon} alt="" width="30" height="30" loading="lazy" />
          )}
          <span class="fs-title">{s.title}</span>
          <code class="fs-cli">{s.cli}</code>
        </li>
      ))
    }
  </ol>

  <figcaption id="fs-caption">
    All on the workstation with ESP-IDF. Success = serial shows
    <code>wifi connected</code> → <code>discover response</code> →
    <code>mqtt connected to core</code>, then button → RGB and telemetry every 10 s.
  </figcaption>
</figure>

<style>
  .fs {
    margin: 1.5rem 0;
  }

  .fs-rail {
    margin: 0;
    padding: 1rem 0.9rem;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.85rem;
    background:
      radial-gradient(
        ellipse 90% 60% at 50% -10%,
        var(--patina-accent-soft),
        transparent 70%
      ),
      var(--sl-color-bg-nav);
  }

  .fs-step {
    flex: 1 1 9rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
    padding: 0.75rem 0.6rem 0.7rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.65rem;
    background: var(--sl-color-bg);
  }

  .fs-step img {
    display: block;
  }

  .fs-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.3rem;
    block-size: 1.3rem;
    border-radius: 999px;
    font-family: var(--sl-font-headings);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--sl-color-text-invert);
    background: var(--sl-color-accent);
  }

  .fs-title {
    font-family: var(--sl-font-headings);
    font-weight: 700;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-white);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .fs-cli {
    font-size: 0.62rem;
    color: var(--sl-color-text-accent);
    background: var(--sl-color-bg-inline-code);
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    max-width: 100%;
    overflow-wrap: anywhere;
    line-height: 1.3;
  }

  figcaption {
    margin-top: 0.9rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }

  figcaption code {
    font-size: 0.82em;
    background: var(--sl-color-bg-inline-code);
    padding: 0.05rem 0.3rem;
    border-radius: 0.25rem;
  }
</style>

<script>
  // Swap general-set icons (Dark ↔ Light) with the Starlight theme.
  function applyIconTheme() {
    const light = document.documentElement.dataset.theme === "light";
    document.querySelectorAll<HTMLImageElement>(".fs-ico[data-light]").forEach((el) => {
      if (!el.dataset.darkSrc) el.dataset.darkSrc = el.getAttribute("src") || "";
      const target = light ? el.getAttribute("data-light") : el.dataset.darkSrc;
      if (target && el.getAttribute("src") !== target) el.setAttribute("src", target);
    });
  }

  applyIconTheme();
  const obs = new MutationObserver(applyIconTheme);
  obs.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  document.addEventListener("astro:after-swap", applyIconTheme);
</script>
