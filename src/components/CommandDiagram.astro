---
/**
 * CommandDiagram — this page: alarm → SNS → Lambda → IoT command → blue RGB + ack.
 * Icons from https://aws-icons.johna.kiwi/ under AWS Trademark Guidelines.
 */
const ICONS = "https://aws-icons.johna.kiwi/icons";

const img = {
  cw: `${ICONS}/service/management/Arch_Amazon-CloudWatch_64.svg`,
  sns: `${ICONS}/service/integration/Arch_Amazon-Simple-Notification-Service_64.svg`,
  lambda: `${ICONS}/service/compute/Arch_AWS-Lambda_64.svg`,
  iot: `${ICONS}/service/iot/Arch_AWS-IoT-Core_64.svg`,
  core: `${ICONS}/service/iot/Arch_AWS-IoT-Greengrass_64.svg`,
  client: `${ICONS}/resource/iot/Res_AWS-IoT_Thing_FreeRTOS-Device_48.svg`,
};
---

<figure class="cmd not-content" aria-labelledby="cmd-caption">
  <div class="cmd-row">
    <div class="cmd-node">
      <img src={img.cw} alt="" width="36" height="36" loading="lazy" />
      <span class="cmd-name">Alarm</span>
    </div>
    <span class="cmd-hop" data-label="">→</span>
    <div class="cmd-node">
      <img src={img.sns} alt="" width="36" height="36" loading="lazy" />
      <span class="cmd-name">SNS</span>
    </div>
    <span class="cmd-hop" data-label="">→</span>
    <div class="cmd-node cmd-node--hub">
      <img src={img.lambda} alt="" width="36" height="36" loading="lazy" />
      <span class="cmd-name">Lambda</span>
      <span class="cmd-sub">alarm-to-command</span>
    </div>
    <span class="cmd-hop" data-label="cloud/command">→</span>
    <div class="cmd-node">
      <img src={img.iot} alt="" width="36" height="36" loading="lazy" />
      <span class="cmd-name">IoT Core</span>
    </div>
    <span class="cmd-hop" data-label="bridge">→</span>
    <div class="cmd-node">
      <img src={img.core} alt="" width="36" height="36" loading="lazy" />
      <span class="cmd-name">GgEdgeLoop</span>
    </div>
    <span class="cmd-hop" data-label="blue">→</span>
    <div class="cmd-node cmd-node--dest">
      <img src={img.client} alt="" width="36" height="36" loading="lazy" />
      <span class="cmd-name">ESP32 RGB</span>
    </div>
  </div>

  <figcaption id="cmd-caption">
    Manual <code>iot-data publish</code> hits the same bridge path. Ack lands in
    DynamoDB as <code>kind=cloud-ack</code>.
  </figcaption>
</figure>

<style>
  .cmd {
    margin: 1.5rem 0;
  }

  .cmd-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 1.1rem 0.95rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.9rem;
    background:
      radial-gradient(
        ellipse 90% 55% at 50% -8%,
        var(--patina-accent-soft, color-mix(in oklab, var(--sl-color-accent) 12%, transparent)),
        transparent 70%
      ),
      var(--sl-color-bg-nav);
  }

  .cmd-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    width: min(100%, 20rem);
    padding: 0.6rem 0.5rem;
    text-align: center;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    background: var(--sl-color-bg);
  }

  .cmd-node--hub {
    border-color: color-mix(in oklab, #3b82f6 40%, var(--sl-color-hairline));
  }

  .cmd-node--dest {
    border-color: color-mix(in oklab, #3b82f6 45%, var(--sl-color-hairline));
  }

  .cmd-name {
    font-family: var(--sl-font-headings);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--sl-color-white);
  }

  .cmd-sub {
    font-size: 0.58rem;
    color: var(--sl-color-gray-3);
  }

  /* "label ↓" between vertically stacked nodes. The element's own text is the
     inline "→" glyph — hide it and draw the label (if any) + a down arrow. */
  .cmd-hop {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0;
    color: var(--sl-color-accent);
    font-weight: 700;
    line-height: 1;
    font-size: 0;
  }

  .cmd-hop::before {
    content: attr(data-label);
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
    line-height: 1.2;
  }

  .cmd-hop::after {
    content: "↓";
    font-size: 1rem;
    color: var(--sl-color-accent);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.45;
  }

  figcaption code {
    font-size: 0.85em;
    background: var(--sl-color-bg-inline-code);
    padding: 0.05rem 0.3rem;
    border-radius: 0.25rem;
  }
</style>
